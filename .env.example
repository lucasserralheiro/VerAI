NODE_ENV=development

# Database
DATABASE_URL="postgresql://verai_user:verai_pass@localhost:5433/verai"
POSTGRES_DB=verai
POSTGRES_USER=verai_user
POSTGRES_PASSWORD=verai_pass

# Auth
JWT_SECRET=

# Upload local
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:3000/api/uploads

# Camada de IA
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# URL pública da aplicação (usada nos links de e-mail de notificação)
APP_URL=http://localhost:3000

# E-mail (Resend) — se vazio, notificações por e-mail são só logadas, não enviadas
RESEND_API_KEY=
EMAIL_FROM=
