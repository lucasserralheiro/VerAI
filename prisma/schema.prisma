generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id         String   @id @default(cuid())
  nome       String
  email      String   @unique
  senhaHash  String
  role       String   // uploader | responsavel | admin
  createdAt  DateTime @default(now())
  documentos Documento[]
  acessos    AcessoDocumento[]
  clientesPermitidos Cliente[] @relation("UsuarioClientes")
}

model Cliente {
  id                 String      @id @default(cuid())
  nome               String      @unique
  createdAt          DateTime    @default(now())
  usuariosPermitidos Usuario[]   @relation("UsuarioClientes")
  documentos         Documento[]
  analisesConsolidadas AnaliseConsolidada[]
  analisesEvolucao  AnaliseEvolucao[]
  analisesMedicaoContratual AnaliseMedicaoContratual[]
}

model AnaliseEvolucao {
  id                     String    @id @default(cuid())
  clienteId              String
  cliente                Cliente   @relation(fields: [clienteId], references: [id])
  competenciaAtualAno    Int
  competenciaAtualMes    Int
  competenciaAnteriorAno Int
  competenciaAnteriorMes Int
  metricasComparadas     Json
  resumo                 String    @db.Text
  pontosAtencao          Json
  melhorias              Json
  promptVersion          String
  caminhoRelatorioPdf    String?
  relatorioGeradoEm      DateTime?
  createdAt              DateTime  @default(now())

  @@unique([clienteId, competenciaAtualAno, competenciaAtualMes])
}

model AnaliseConsolidada {
  id                  String      @id @default(cuid())
  clienteId           String
  cliente             Cliente     @relation(fields: [clienteId], references: [id])
  competenciaAno      Int
  competenciaMes      Int
  documentos          Documento[] @relation("DocumentosDaConsolidada")
  selecaoAssinatura   String
  resumo              String      @db.Text
  pontosCriticos      Json
  pontosPositivos     Json
  metricasComparadas  Json
  recomendacoes       Json?
  promptVersion       String
  caminhoRelatorioPdf String?
  relatorioGeradoEm   DateTime?
  createdAt           DateTime    @default(now())

  @@unique([clienteId, competenciaAno, competenciaMes, selecaoAssinatura])
}

model Documento {
  id              String    @id @default(cuid())
  nomeArquivo     String
  tipo            String    // xlsx, csv, pdf, docx
  caminhoOriginal String
  tamanhoBytes    Int
  status          String    @default("processando") // processando | concluido | erro
  mensagemErro    String?
  uploadedById    String
  uploadedBy      Usuario   @relation(fields: [uploadedById], references: [id])
  clienteId       String
  cliente         Cliente   @relation(fields: [clienteId], references: [id])
  competenciaAno  Int
  competenciaMes  Int
  createdAt       DateTime  @default(now())
  analise         Analise?
  acessos         AcessoDocumento[]
  notificacoes    Notificacao[]
  analisesConsolidadas AnaliseConsolidada[] @relation("DocumentosDaConsolidada")

  @@index([clienteId, competenciaAno, competenciaMes])
}

model Analise {
  id                  String    @id @default(cuid())
  documentoId         String    @unique
  documento           Documento @relation(fields: [documentoId], references: [id])
  resumo              String    @db.Text
  pontosCriticos      Json
  pontosPositivos     Json
  metricasChave       Json?
  recomendacoes       Json?
  promptVersion       String
  caminhoRelatorioPdf String?
  relatorioGeradoEm   DateTime?
  createdAt           DateTime  @default(now())
}

model PropostaComercial {
  id               String    @id @default(cuid())
  // Nome de exibição da proposta — herda o nome do primeiro arquivo enviado
  // no momento da criação (múltiplos arquivos vivem em `arquivos` abaixo).
  nomeArquivo      String
  tamanhoBytes     Int       // soma dos arquivos em `arquivos`
  conteudoMarkdown String?   @db.Text // resumo consolidado final — null até concluir, ou quando status é "erro"
  status           String    @default("rascunho") // rascunho | concluido | erro
  mensagemErro     String?
  // Resultado da checagem por IA da conversão (score, trechos suspeitos,
  // páginas com imagem + ids dos PDFs checados). Só depende dos PDFs, então
  // é reaproveitado até os arquivos mudarem ou alguém pedir "checar de novo".
  checagemIa       Json?
  checagemIaEm     DateTime?
  // Resultado da conferência determinística (sem IA) dos valores de total/
  // resultado geral do PDF contra o documento — atalho rápido, separado da
  // checagem por IA (ver docs/superpowers/specs/2026-09-16-conferencia-totais-design.md).
  conferenciaTotais   Json?
  conferenciaTotaisEm DateTime?
  createdAt        DateTime  @default(now())
  arquivos         PropostaComercialArquivo[]
}

// Cada arquivo de origem enviado numa conversão (PDF, planilha ou Word) — uma
// proposta pode juntar vários; o conteúdo de cada um é extraído individualmente
// e depois consolidado num único `conteudoMarkdown` na PropostaComercial.
model PropostaComercialArquivo {
  id               String            @id @default(cuid())
  propostaId       String
  proposta         PropostaComercial @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  nomeArquivo      String
  tipo             String            // pdf | xlsx | csv | docx
  tamanhoBytes     Int
  caminhoOriginal  String
  conteudoExtraido String?           @db.Text // null quando a extração desse arquivo específico falhou
  ordem            Int               // ordem de upload — preserva a sequência que o usuário escolheu
  createdAt        DateTime          @default(now())

  @@index([propostaId])
}

model RegraNotificacao {
  id            String @id @default(cuid())
  criterioTipo  String // tipoDocumento | palavraChaveNome
  criterioValor String
  destinatarios Json
}

model Notificacao {
  id           String    @id @default(cuid())
  documentoId  String
  documento    Documento @relation(fields: [documentoId], references: [id])
  destinatario String
  canal        String    // email | dashboard
  lida         Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

// Análise de medição contratual (integração com o serviço Confere) — compara
// contrato x planilha de levantamento (mais aditivos opcionais) e devolve um
// relatório estruturado (docs/superpowers/specs/2026-09-21-integracao-confere-design.md).
//
// Diferente de AnaliseConsolidada/AnaliseEvolucao, os arquivos de entrada não
// reaproveitam o model Documento: são upload dedicado só pra essa análise
// (decisão de 2026-09-21 — ver design doc §3.6), guardados em
// AnaliseMedicaoContratualArquivo.
//
// `resultado` guarda a resposta estruturada do Confere (RespostaRelatorio)
// sem os campos *_base64 — esses viram os dois arquivos gerados
// (caminhoRelatorioDocx/Xlsx). Quando o Confere bloqueia (achado bloqueante,
// RespostaBloqueada), não há relatório: `achadosBloqueio` guarda bloqueantes/
// avisos/confirmáveis, e `status` fica "bloqueado".
model AnaliseMedicaoContratual {
  id                   String    @id @default(cuid())
  clienteId            String
  cliente              Cliente   @relation(fields: [clienteId], references: [id])
  competenciaAno       Int
  competenciaMes       Int
  status               String    @default("processando") // processando | concluido | bloqueado | erro
  mensagemErro         String?
  // Espelha o `identidade_confirmada` do Confere — true quando o usuário já
  // seguiu em frente apesar de achados "confirmáveis" (RespostaBloqueada.confirmaveis).
  identidadeConfirmada Boolean   @default(false)
  resultado            Json?
  achadosBloqueio      Json?
  caminhoRelatorioDocx String?
  caminhoRelatorioXlsx String?
  relatorioGeradoEm    DateTime?
  createdAt            DateTime  @default(now())
  arquivos             AnaliseMedicaoContratualArquivo[]

  @@unique([clienteId, competenciaAno, competenciaMes])
}

// Um arquivo de entrada enviado para uma AnaliseMedicaoContratual — exatamente
// um "contrato", exatamente um "levantamento", e zero ou mais "aditivo"
// (mesmo papel que o Confere espera em `POST /reports`).
model AnaliseMedicaoContratualArquivo {
  id              String                   @id @default(cuid())
  analiseId       String
  analise         AnaliseMedicaoContratual @relation(fields: [analiseId], references: [id], onDelete: Cascade)
  papel           String                   // contrato | levantamento | aditivo
  nomeArquivo     String
  tamanhoBytes    Int
  caminhoOriginal String
  ordem           Int                      // relevante só entre os aditivos — preserva a ordem de upload
  createdAt       DateTime                 @default(now())

  @@index([analiseId])
}

model AcessoDocumento {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id])
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  acao        String    // visualizou | baixou_original | baixou_relatorio
  createdAt   DateTime  @default(now())
}
