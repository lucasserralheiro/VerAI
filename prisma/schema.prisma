generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                 String            @id @default(cuid())
  nome               String
  email              String            @unique
  senhaHash          String
  role               String // uploader | responsavel | admin
  createdAt          DateTime          @default(now())
  documentos         Documento[]
  acessos            AcessoDocumento[]
  clientesPermitidos Cliente[]         @relation("UsuarioClientes")
}

model Cliente {
  id                   String               @id @default(cuid())
  nome                 String               @unique
  // Sigla do cliente no legado GRC-1 (SMS, SME, SF, SGM, SEGES, SMT, ...) — chave de
  // casamento usada pelo script de importação (Task 2), não o nome (frágil a
  // divergência de grafia). Ver docs/superpowers/specs/2026-09-22-relatorios-clientes-design.md §3.4.
  siglaLegado          String?              @unique
  endereco             String?
  numero               String?
  bairro               String?
  createdAt            DateTime             @default(now())
  usuariosPermitidos   Usuario[]            @relation("UsuarioClientes")
  documentos           Documento[]
  analisesConsolidadas AnaliseConsolidada[]
  analisesEvolucao     AnaliseEvolucao[]
  responsaveis         ResponsavelCliente[]
  fornecedorTermos     TermoConfirmacao[]
  contratos            Contrato[]
  faturamentos         Faturamento[]
  demandas             Demanda[]
  solicitacoes         Solicitacao[]
}

// ---------------------------------------------------------------------------
// Migração do legado GRC-1 (Access) — ver
// docs/superpowers/specs/2026-09-22-relatorios-clientes-design.md §4 pro
// mapeamento tabela-a-tabela e docs/superpowers/plans/2026-09-22-relatorios-clientes.md
// pro plano de execução.
//
// Todo model desta seção carrega `legacyId Int? @unique`: é a chave de
// idempotência do script de importação (Task 2, ainda não escrito) — permite
// rodar a importação mais de uma vez sem duplicar registro (§3.2 do design).
// ---------------------------------------------------------------------------

model ResponsavelCliente {
  id        String   @id @default(cuid())
  legacyId  Int?     @unique
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  nome      String
  area      String?
  email     String?
  telefone  String?
  celular   String?
  createdAt DateTime @default(now())

  @@index([clienteId])
}

// Cadastro de fornecedor (T_Fornecedor). O design doc não lista os campos —
// modelado como um cadastro razoável (nome/razão social, CNPJ, contato); ver
// ressalva no relatório da Task 1.
model Fornecedor {
  id                         String                      @id @default(cuid())
  legacyId                   Int?                        @unique
  razaoSocial                String
  cnpj                       String?
  contato                    String?
  createdAt                  DateTime                    @default(now())
  contratosOperacionalizacao ContratoOperacionalizacao[]
  termosConfirmacao          TermoConfirmacao[]
}

// Contrato de operacionalização (CO) — lado do fornecedor (T_CO_Operacionalização).
// Design doc não lista campos; modelado com vigência + valor (mais `numero`
// como identificador do CO) — ver ressalva no relatório da Task 1.
model ContratoOperacionalizacao {
  id           String     @id @default(cuid())
  legacyId     Int?       @unique
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])
  numero       String?
  dataInicio   DateTime?
  dataFim      DateTime?
  valor        Decimal?   @db.Decimal(14, 2)
  createdAt    DateTime   @default(now())

  @@index([fornecedorId])
}

// Termo de confirmação — a ponte fornecedor ↔ cliente, via Contrato (T_TermoConfirmação).
// `clienteId` é direto (denormalizado) pra sustentar `Cliente.fornecedorTermos`;
// `contratoId` é opcional porque nem todo termo necessariamente já tem um
// Contrato de receita vinculado no momento do cadastro. Campos além dos FKs
// (data, observação) são cadastro razoável — design doc não lista os campos
// próprios da tabela; ver ressalva no relatório da Task 1.
model TermoConfirmacao {
  id           String     @id @default(cuid())
  legacyId     Int?       @unique
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])
  clienteId    String
  cliente      Cliente    @relation(fields: [clienteId], references: [id])
  contratoId   String?
  contrato     Contrato?  @relation(fields: [contratoId], references: [id])
  data         DateTime?
  observacao   String?
  createdAt    DateTime   @default(now())

  @@index([fornecedorId])
  @@index([clienteId])
  @@index([contratoId])
}

// Contrato de receita — cabeçalho (T_ContratoReceita). Campos citados em prosa
// no design doc §3.7/§4: "Nº Termo, SEI Cliente/PRODAM, situação" — SEI
// Cliente/PRODAM modelado como dois campos (`seiCliente`, `seiProdam`), um pra
// cada processo SEI; ver ressalva no relatório da Task 1.
model Contrato {
  id                String              @id @default(cuid())
  legacyId          Int?                @unique
  clienteId         String
  cliente           Cliente             @relation(fields: [clienteId], references: [id])
  numeroTermo       String?
  seiCliente        String?
  seiProdam         String?
  situacao          String?
  createdAt         DateTime            @default(now())
  historico         HistoricoContrato[]
  itens             ItemContrato[]
  faturamentos      Faturamento[]
  termosConfirmacao TermoConfirmacao[]

  @@index([clienteId])
}

// Histórico do contrato — linha do tempo única (T_Propostas), não entidades
// separadas por tipo. Ver design doc §3.5: cada linha tem um `tipo` (Contrato,
// Aditivo, Prorrogação, Rescisão, Prospecção). `T_Aditivo` (0 linhas no
// legado) não é migrada como entidade própria.
enum TipoHistoricoContrato {
  CONTRATO
  ADITIVO
  PRORROGACAO
  RESCISAO
  PROSPECCAO
}

model HistoricoContrato {
  id         String                @id @default(cuid())
  legacyId   Int?                  @unique
  contratoId String
  contrato   Contrato              @relation(fields: [contratoId], references: [id])
  tipo       TipoHistoricoContrato
  numero     String?
  data       DateTime?
  valor      Decimal?              @db.Decimal(14, 2)
  observacao String?
  createdAt  DateTime              @default(now())

  @@index([contratoId])
}

// Item de contrato (T_ItensContrato) — base pretendida do cálculo de saldo (§3.6 do design doc).
// `valorTotal` é citado nominalmente no design doc; `descricao`/`quantidade`/`valorUnitario` são
// cadastro razoável — ver ressalva no relatório da Task 1.
//
// `contratoId` é OPCIONAL (mudança feita na Task 2, não na Task 1 original) — achado da Task 2:
// não existe, nos dados reais, nenhuma chave de junção confiável entre `T_ItensContrato` e
// `T_ContratoReceita` (nenhuma FK declarada no .accdb; o texto livre da coluna `Contrato` não bate
// com nenhum campo identificador de `T_ContratoReceita`, mesmo escopado por cliente — 0/146 numa
// checagem manual contra a cópia de teste; a coluna `Cliente` de T_ItensContrato cita 37 siglas,
// a maioria fora dos clientes deste GRC-1, sugerindo uma tabela de itens mais ampla da PRODAM).
// `contratoTextoLegado` guarda o valor bruto da coluna `Contrato` do Access pra permitir
// reconciliação manual depois — ver
// docs/superpowers/specs/2026-09-22-relatorios-clientes-design.md §3.6 (revisto) e o relatório da
// Task 2 (.superpowers/sdd/2026-09-22-relatorios-clientes/task-2-report.md).
model ItemContrato {
  id                  String    @id @default(cuid())
  legacyId            Int?      @unique
  contratoId          String?
  contrato            Contrato? @relation(fields: [contratoId], references: [id])
  // Valor bruto da coluna "Contrato" de T_ItensContrato (ex. "031/SEME/2017") quando não foi
  // possível casar com um Contrato do VerAI — só preenchido quando `contratoId` é null.
  contratoTextoLegado String?
  descricao           String?
  quantidade          Decimal?  @db.Decimal(14, 2)
  valorUnitario       Decimal?  @db.Decimal(14, 2)
  valorTotal          Decimal   @db.Decimal(14, 2)
  createdAt           DateTime  @default(now())

  @@index([contratoId])
}

// Faturamento mensal (T_Faturamentos). `clienteId` é direto (denormalizado),
// além de `contratoId`, pra sustentar `Cliente.faturamentos` sem precisar
// atravessar Contrato em toda consulta da ficha do cliente (§3.7 do design doc).
model Faturamento {
  id             String       @id @default(cuid())
  legacyId       Int?         @unique
  contratoId     String
  contrato       Contrato     @relation(fields: [contratoId], references: [id])
  clienteId      String
  cliente        Cliente      @relation(fields: [clienteId], references: [id])
  competenciaAno Int?
  competenciaMes Int?
  valor          Decimal?     @db.Decimal(14, 2)
  situacao       String?
  createdAt      DateTime     @default(now())
  notasFiscais   NotaFiscal[]

  @@index([contratoId])
  @@index([clienteId])
}

// Nota fiscal (T_NotaFiscal) — liga a Faturamento, não a ItemContrato (o
// legado não tem esse vínculo; ver §3.6 do design doc).
model NotaFiscal {
  id            String      @id @default(cuid())
  legacyId      Int?        @unique
  faturamentoId String
  faturamento   Faturamento @relation(fields: [faturamentoId], references: [id])
  numero        String?
  valor         Decimal?    @db.Decimal(14, 2)
  dataEmissao   DateTime?
  createdAt     DateTime    @default(now())

  @@index([faturamentoId])
}

// Demanda/documento (T_Documento). Campos citados em prosa no design doc §4:
// "assunto, tipo, responsável"; `situacao`/`dataAbertura`/`clienteId` são
// cadastro razoável — ver ressalva no relatório da Task 1.
model Demanda {
  id           String           @id @default(cuid())
  legacyId     Int?             @unique
  clienteId    String
  cliente      Cliente          @relation(fields: [clienteId], references: [id])
  assunto      String?
  tipo         String?
  responsavel  String?
  situacao     String?
  dataAbertura DateTime?
  createdAt    DateTime         @default(now())
  tramites     TramiteDemanda[]

  @@index([clienteId])
}

// Trâmite de uma demanda (T_Trâmite) — histórico de posição/ação, citado em
// prosa no design doc §4. `data`/`observacao` são cadastro razoável.
model TramiteDemanda {
  id         String    @id @default(cuid())
  legacyId   Int?      @unique
  demandaId  String
  demanda    Demanda   @relation(fields: [demandaId], references: [id])
  data       DateTime?
  posicao    String?
  acao       String?
  observacao String?
  createdAt  DateTime  @default(now())

  @@index([demandaId])
}

// Solicitação de TI — RDM/Solicitação (T_Solicitação). Design doc só cita
// "chamados de TI (RDM/Solicitação)"; campos são cadastro razoável — ver
// ressalva no relatório da Task 1. `legacyId` vem do "Nº" da solicitação
// (§3.2 do design doc).
model Solicitacao {
  id           String    @id @default(cuid())
  legacyId     Int?      @unique
  clienteId    String
  cliente      Cliente   @relation(fields: [clienteId], references: [id])
  tipo         String?
  descricao    String?
  situacao     String?
  dataAbertura DateTime?
  createdAt    DateTime  @default(now())

  @@index([clienteId])
}

model AnaliseEvolucao {
  id                     String    @id @default(cuid())
  clienteId              String
  cliente                Cliente   @relation(fields: [clienteId], references: [id])
  competenciaAtualAno    Int
  competenciaAtualMes    Int
  competenciaAnteriorAno Int
  competenciaAnteriorMes Int
  metricasComparadas     Json
  resumo                 String    @db.Text
  pontosAtencao          Json
  melhorias              Json
  promptVersion          String
  caminhoRelatorioPdf    String?
  relatorioGeradoEm      DateTime?
  createdAt              DateTime  @default(now())

  @@unique([clienteId, competenciaAtualAno, competenciaAtualMes])
}

model AnaliseConsolidada {
  id                  String      @id @default(cuid())
  clienteId           String
  cliente             Cliente     @relation(fields: [clienteId], references: [id])
  competenciaAno      Int
  competenciaMes      Int
  documentos          Documento[] @relation("DocumentosDaConsolidada")
  selecaoAssinatura   String
  resumo              String      @db.Text
  pontosCriticos      Json
  pontosPositivos     Json
  metricasComparadas  Json
  recomendacoes       Json?
  promptVersion       String
  caminhoRelatorioPdf String?
  relatorioGeradoEm   DateTime?
  createdAt           DateTime    @default(now())

  @@unique([clienteId, competenciaAno, competenciaMes, selecaoAssinatura])
}

model Documento {
  id                   String               @id @default(cuid())
  nomeArquivo          String
  tipo                 String // xlsx, csv, pdf, docx
  caminhoOriginal      String
  tamanhoBytes         Int
  status               String               @default("processando") // processando | concluido | erro
  mensagemErro         String?
  uploadedById         String
  uploadedBy           Usuario              @relation(fields: [uploadedById], references: [id])
  clienteId            String
  cliente              Cliente              @relation(fields: [clienteId], references: [id])
  competenciaAno       Int
  competenciaMes       Int
  createdAt            DateTime             @default(now())
  analise              Analise?
  acessos              AcessoDocumento[]
  notificacoes         Notificacao[]
  analisesConsolidadas AnaliseConsolidada[] @relation("DocumentosDaConsolidada")

  @@index([clienteId, competenciaAno, competenciaMes])
}

model Analise {
  id                  String    @id @default(cuid())
  documentoId         String    @unique
  documento           Documento @relation(fields: [documentoId], references: [id])
  resumo              String    @db.Text
  pontosCriticos      Json
  pontosPositivos     Json
  metricasChave       Json?
  recomendacoes       Json?
  promptVersion       String
  caminhoRelatorioPdf String?
  relatorioGeradoEm   DateTime?
  createdAt           DateTime  @default(now())
}

model PropostaComercial {
  id                  String                     @id @default(cuid())
  // Nome de exibição da proposta — herda o nome do primeiro arquivo enviado
  // no momento da criação (múltiplos arquivos vivem em `arquivos` abaixo).
  nomeArquivo         String
  tamanhoBytes        Int // soma dos arquivos em `arquivos`
  conteudoMarkdown    String?                    @db.Text // resumo consolidado final — null até concluir, ou quando status é "erro"
  status              String                     @default("rascunho") // rascunho | concluido | erro
  mensagemErro        String?
  // Resultado da checagem por IA da conversão (score, trechos suspeitos,
  // páginas com imagem + ids dos PDFs checados). Só depende dos PDFs, então
  // é reaproveitado até os arquivos mudarem ou alguém pedir "checar de novo".
  checagemIa          Json?
  checagemIaEm        DateTime?
  // Resultado da conferência determinística (sem IA) dos valores de total/
  // resultado geral do PDF contra o documento — atalho rápido, separado da
  // checagem por IA (ver docs/superpowers/specs/2026-09-16-conferencia-totais-design.md).
  conferenciaTotais   Json?
  conferenciaTotaisEm DateTime?
  createdAt           DateTime                   @default(now())
  arquivos            PropostaComercialArquivo[]
}

// Cada arquivo de origem enviado numa conversão (PDF, planilha ou Word) — uma
// proposta pode juntar vários; o conteúdo de cada um é extraído individualmente
// e depois consolidado num único `conteudoMarkdown` na PropostaComercial.
model PropostaComercialArquivo {
  id               String            @id @default(cuid())
  propostaId       String
  proposta         PropostaComercial @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  nomeArquivo      String
  tipo             String // pdf | xlsx | csv | docx
  tamanhoBytes     Int
  caminhoOriginal  String
  conteudoExtraido String?           @db.Text // null quando a extração desse arquivo específico falhou
  ordem            Int // ordem de upload — preserva a sequência que o usuário escolheu
  createdAt        DateTime          @default(now())

  @@index([propostaId])
}

model RegraNotificacao {
  id            String @id @default(cuid())
  criterioTipo  String // tipoDocumento | palavraChaveNome
  criterioValor String
  destinatarios Json
}

model Notificacao {
  id           String    @id @default(cuid())
  documentoId  String
  documento    Documento @relation(fields: [documentoId], references: [id])
  destinatario String
  canal        String // email | dashboard
  lida         Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model AcessoDocumento {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id])
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  acao        String // visualizou | baixou_original | baixou_relatorio
  createdAt   DateTime  @default(now())
}

// Histórico do ConfereAI (`/confere`). A geração em si continua sem estado —
// o Confere é um serviço à parte que não persiste nada e devolve os dois
// documentos no corpo da resposta. O que esta tabela guarda é só o registro
// do que passou por ali: o NOME dos arquivos submetidos (não os arquivos) e
// os dois documentos gerados, pra poder rebaixar sem repetir os ~25s de
// processamento.
//
// Sem vínculo com Cliente nem competência, pelo mesmo motivo que a tela não
// tem: `/confere` é uma ferramenta solta, não um passo do fluxo de cliente
// (ver docs/superpowers/specs/2026-09-21-integracao-confere-design.md §3.7).
model ConfereExecucao {
  id               String   @id
  // Só o nome com que o arquivo foi submetido — o PDF e a planilha em si não
  // são guardados em lugar nenhum.
  nomeContrato     String
  nomeLevantamento String
  // Lista de nomes, na ordem de aplicação (que é a ordem em que foram
  // selecionados). Vazia quando o envio não teve aditivo.
  nomesAditivos    Json     @default("[]")
  // URLs no Vercel Blob dos dois documentos gerados.
  caminhoDocx      String
  caminhoXlsx      String
  // A resposta do Confere **sem** os dois base64 (que já viraram os arquivos
  // acima): grid de divergências, placar, análise, avisos. É o que permite
  // reabrir o mesmo resultado em `/confere/historico/[id]` com a tela de
  // sempre, em vez de só rebaixar os arquivos. Opcional porque as execuções
  // gravadas antes deste campo não o têm.
  resultado        Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
}
