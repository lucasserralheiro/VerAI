{
  "name": "verai",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "jest --passWithNoTests",
    "dev:db:up": "docker compose --env-file .env.development up -d",
    "dev:db:down": "docker compose --env-file .env.development down",
    "dev:migrate": "dotenv -e .env.development -- npx prisma migrate dev",
    "dev:generate": "dotenv -e .env.development -- npx prisma generate",
    "dev:studio": "dotenv -e .env.development -- npx prisma studio",
    "dev:seed": "dotenv -e .env.development -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/google-vertex": "^5.0.56",
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.6.1",
    "ai": "^7.0.67",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jose": "^5.10.0",
    "lucide-react": "^1.32.0",
    "next": "15.5.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.20.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
