NODE_ENV=development

# Database
DATABASE_URL="postgresql://verai_user:verai_pass@localhost:5433/verai"
POSTGRES_DB=verai
POSTGRES_USER=verai_user
POSTGRES_PASSWORD=verai_pass

# Auth
JWT_SECRET=

# Modo de desenvolvimento — login por token + "Simular usuário" no header.
# "1" liga; vazio/ausente desliga (mantenha desligado em produção real).
DEV_AUTH_ENABLED=
DEV_AUTH_TOKEN=

# Upload (Vercel Blob) — em produção o Vercel injeta essa var automaticamente
# ao conectar um Blob store ao projeto. Em dev local, gere um token em
# https://vercel.com/dashboard -> Storage -> seu Blob store -> .env.local
BLOB_READ_WRITE_TOKEN=

# Arquivos da biblioteca ContratosReceita do SharePoint (Cloudflare R2, bucket PRIVADO) — spec
# docs/superpowers/specs/2026-09-23-sharepoint-lugar-certo-design.md §11. Token de API do R2 com
# "Object Read & Write" só nesse bucket. Precisa estar aqui (scripts) e nas variáveis da Vercel.
R2_ACCOUNT_ID=
R2_BUCKET=verai-documentos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Camada de IA
# AI_PROVIDER=anthropic | google | vertex | groq | deepseek
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Modelo usado só na revisão de português da Proposta Comercial (tarefa
# mecânica — pode ser um modelo mais rápido/barato). Se vazio, usa AI_MODEL.
AI_REVISAO_MODEL=

# Só necessário se AI_PROVIDER=vertex (usa Application Default Credentials do
# gcloud, não usa AI_API_KEY)
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=

# URL pública da aplicação (usada nos links de e-mail de notificação)
APP_URL=http://localhost:3000

# E-mail (Resend) — se vazio, notificações por e-mail são só logadas, não enviadas
RESEND_API_KEY=
EMAIL_FROM=

# Confere (docs/superpowers/specs/2026-09-21-integracao-confere-design.md) —
# serviço externo (Python/FastAPI) que compara contrato x medição. Rodando no
# Render (free tier): https://confere-backend.onrender.com
CONFERE_SERVICE_URL=
CONFERE_SHARED_SECRET=

# Modelo de endereço pra abrir um processo SEI a partir do número (usado pelo SeiLink quando o
# processo não tem link cadastrado). {numero} = com máscara (6017.2024/0028323-7), {digitos} = só dígitos.
# Vazio = o clique no número apenas copia.
NEXT_PUBLIC_SEI_URL_TEMPLATE=

# Assistente de IA (botão flutuante) — ver docs/superpowers/specs/2026-09-23-assistente-ia-design.md
# Se vazios, usa AI_PROVIDER / AI_MODEL / AI_API_KEY.
ASSISTENTE_AI_PROVIDER=deepseek
ASSISTENTE_AI_MODEL=deepseek-chat
ASSISTENTE_AI_API_KEY=
# Preço em USD por milhão de tokens (conferir em platform.deepseek.com) — só para a tela de custo.
ASSISTENTE_PRECO_ENTRADA=
ASSISTENTE_PRECO_ENTRADA_CACHE=
ASSISTENTE_PRECO_SAIDA=
# Segredo do Cron da Vercel que mantém o índice de documentos atualizado.
CRON_SECRET=

