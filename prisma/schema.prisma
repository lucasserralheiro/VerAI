generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                 String            @id @default(cuid())
  nome               String
  email              String            @unique
  senhaHash          String
  role               String // uploader | responsavel | admin
  createdAt          DateTime          @default(now())
  documentos         Documento[]
  acessos            AcessoDocumento[]
  clientesPermitidos Cliente[]         @relation("UsuarioClientes")
  conversasAssistente ConversaAssistente[]
  arquivosEnviados   ArquivoCliente[]  @relation("ArquivosEnviados")
  acessosArquivo     AcessoArquivo[]   @relation("AcessosArquivo")
  reajustes          ReajusteExecucao[]
}

model Cliente {
  id                   String               @id @default(cuid())
  nome                 String               @unique
  // Sigla do cliente no legado GRC-1 (SMS, SME, SF, SGM, SEGES, SMT, ...) — chave de
  // casamento usada pelo script de importação (Task 2), não o nome (frágil a
  // divergência de grafia). Ver docs/superpowers/specs/2026-09-22-relatorios-clientes-design.md §3.4.
  siglaLegado          String?              @unique
  endereco             String?
  numero               String?
  bairro               String?
  createdAt            DateTime             @default(now())
  usuariosPermitidos   Usuario[]            @relation("UsuarioClientes")
  documentos           Documento[]
  analisesConsolidadas AnaliseConsolidada[]
  analisesEvolucao     AnaliseEvolucao[]
  responsaveis         ResponsavelCliente[]
  fornecedorTermos     TermoConfirmacao[]
  contratos            Contrato[]
  faturamentos         Faturamento[]
  demandas             Demanda[]
  solicitacoes         Solicitacao[]
  arquivos             ArquivoCliente[]
}

// ---------------------------------------------------------------------------
// Migração do legado GRC-1 (Access) — ver
// docs/superpowers/specs/2026-09-22-relatorios-clientes-design.md §4 pro
// mapeamento tabela-a-tabela e docs/superpowers/plans/2026-09-22-relatorios-clientes.md
// pro plano de execução.
//
// Todo model desta seção carrega `legacyId Int? @unique`: é a chave de
// idempotência do script de importação (Task 2, ainda não escrito) — permite
// rodar a importação mais de uma vez sem duplicar registro (§3.2 do design).
// ---------------------------------------------------------------------------

model ResponsavelCliente {
  id        String   @id @default(cuid())
  legacyId  Int?     @unique
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  nome      String
  area      String?
  email     String?
  telefone  String?
  celular   String?
  createdAt DateTime @default(now())

  @@index([clienteId])
}

// Cadastro de fornecedor (T_Fornecedor). O design doc não lista os campos —
// modelado como um cadastro razoável (nome/razão social, CNPJ, contato); ver
// ressalva no relatório da Task 1.
model Fornecedor {
  id                         String                      @id @default(cuid())
  legacyId                   Int?                        @unique
  razaoSocial                String
  cnpj                       String?
  contato                    String?
  // Colunas reais de T_Fornecedor (levantadas na Task 4): Acordo (fabricante/produto
  // do acordo, ex. "MICROSOFT"), Nº Acordo, DataAssinatura, Processo SEI.
  acordo                     String?
  numeroAcordo               String?
  dataAssinatura             DateTime?
  sei                        String?
  createdAt                  DateTime                    @default(now())
  contratosOperacionalizacao ContratoOperacionalizacao[]
  termosConfirmacao          TermoConfirmacao[]
}

// Contrato de operacionalização (CO) — lado do fornecedor (T_CO_Operacionalização).
// Design doc não lista campos; modelado com vigência + valor (mais `numero`
// como identificador do CO) — ver ressalva no relatório da Task 1.
model ContratoOperacionalizacao {
  id           String     @id @default(cuid())
  legacyId     Int?       @unique
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])
  numero       String?
  dataInicio   DateTime?
  dataFim      DateTime?
  valor        Decimal?   @db.Decimal(14, 2)
  sei          String?
  createdAt    DateTime   @default(now())
  termosConfirmacao TermoConfirmacao[]

  @@index([fornecedorId])
}

// Termo de confirmação — a ponte fornecedor ↔ cliente, via Contrato (T_TermoConfirmação).
// `clienteId` é direto (denormalizado) pra sustentar `Cliente.fornecedorTermos`;
// `contratoId` é opcional porque nem todo termo necessariamente já tem um
// Contrato de receita vinculado no momento do cadastro. Campos além dos FKs
// (data, observação) são cadastro razoável — design doc não lista os campos
// próprios da tabela; ver ressalva no relatório da Task 1.
model TermoConfirmacao {
  id             String     @id @default(cuid())
  legacyId       Int?       @unique
  fornecedorId   String
  fornecedor     Fornecedor @relation(fields: [fornecedorId], references: [id])
  clienteId      String
  cliente        Cliente    @relation(fields: [clienteId], references: [id])
  contratoId     String?
  contrato       Contrato?  @relation(fields: [contratoId], references: [id])
  // CO (lado do fornecedor) a que o termo se refere — coluna `ContratoDespesa` do legado. Fecha a
  // cadeia fornecedor → CO → termo → contrato de receita (antes o import usava o CO só pra achar o
  // fornecedor e descartava o vínculo). Tem que ser um CO do MESMO fornecedor do termo (a API checa).
  contratoOperacionalizacaoId String?
  contratoOperacionalizacao   ContratoOperacionalizacao? @relation(fields: [contratoOperacionalizacaoId], references: [id])
  // Colunas reais de T_TermoConfirmação (Task 4): Nº TC, Valor (texto no Access),
  // Data Início, Data Fim, Processo SEI.
  numero         String?
  valor          Decimal?   @db.Decimal(14, 2)
  vigenciaInicio DateTime?
  vigenciaFim    DateTime?
  sei            String?
  observacao     String?
  createdAt      DateTime   @default(now())

  @@index([fornecedorId])
  @@index([clienteId])
  @@index([contratoId])
  @@index([contratoOperacionalizacaoId])
}

// Contrato de receita — cabeçalho (T_ContratoReceita). Campos citados em prosa
// no design doc §3.7/§4: "Nº Termo, SEI Cliente/PRODAM, situação" — SEI
// Cliente/PRODAM modelado como dois campos (`seiCliente`, `seiProdam`), um pra
// cada processo SEI; ver ressalva no relatório da Task 1.
model Contrato {
  id                String              @id @default(cuid())
  legacyId          Int?                @unique
  clienteId         String
  cliente           Cliente             @relation(fields: [clienteId], references: [id])
  numeroTermo       String?
  seiCliente        String?
  seiProdam         String?
  situacao          String?
  // Colunas reais de T_ContratoReceita (Task 5): Descrição, Início, Término (= vencimento),
  // Vigente, Link SEI (hiperlink do Access, sem os "#").
  descricao         String?
  dataInicio        DateTime?
  dataVencimento    DateTime?
  vigente           Boolean?
  linkSei           String?
  // Chave do contrato na biblioteca ContratosReceita do SharePoint: `<sigla do cliente>|<nº> <ano>`
  // ("ADESAMPA|73 2019") — identidade estável da sincronização, nunca mostrada na tela.
  chaveSharepoint   String?             @unique
  createdAt         DateTime            @default(now())
  historico         HistoricoContrato[]
  itens             ItemContrato[]
  faturamentos      Faturamento[]
  termosConfirmacao TermoConfirmacao[]
  arquivosSharepoint ArquivoSharepoint[]
  confereExecucoes  ConfereExecucao[]

  @@index([clienteId])
}

// Histórico do contrato — linha do tempo única (T_Propostas), não entidades
// separadas por tipo. Ver design doc §3.5: cada linha tem um `tipo` (Contrato,
// Aditivo, Prorrogação, Rescisão, Prospecção). `T_Aditivo` (0 linhas no
// legado) não é migrada como entidade própria.
enum TipoHistoricoContrato {
  CONTRATO
  ADITIVO
  PRORROGACAO
  RESCISAO
  PROSPECCAO
}

model HistoricoContrato {
  id             String                @id @default(cuid())
  legacyId       Int?                  @unique
  contratoId     String
  contrato       Contrato              @relation(fields: [contratoId], references: [id])
  tipo           TipoHistoricoContrato
  numero         String?
  data           DateTime?
  valor          Decimal?              @db.Decimal(14, 2)
  observacao     String?
  // Colunas reais de T_Propostas (Task 5): Objeto, Proposta, Situação, Data início,
  // Vencimento, Envio. `data` continua sendo "Assinada em".
  objeto         String?
  proposta       String?
  situacao       String?
  dataInicio     DateTime?
  dataVencimento DateTime?
  dataEnvio      DateTime?
  // PDFs anexados à linha — colunas PC/PA (proposta comercial / de aditivo) e TC/TA (termo de
  // contrato / termo aditivo) do histórico. Sobem pro Vercel Blob via
  // /api/historico-contrato/[id]/pdf/[tipo], mesmo padrão do PDF do faturamento.
  propostaPdfUrl  String?
  propostaPdfNome String?
  termoPdfUrl     String?
  termoPdfNome    String?
  // Pasta do termo no SharePoint (`${chaveContrato}|${caminho}`) gravada quando a linha nasceu da
  // importação. NÃO é identidade (mover/renomear pasta mudaria a chave): é pista e marca de origem —
  // a linha certa sai de src/lib/importacao-sharepoint/identidade.ts.
  chaveSharepoint String?              @unique
  // Colunas PC/PA e TC/TA por REFERÊNCIA ao repositório do cliente (spec
  // docs/superpowers/specs/2026-09-23-sharepoint-lugar-certo-design.md §3.4). `*DoSharepoint`: a coluna
  // foi preenchida pela sincronização e acompanha o SharePoint; `false` = anexada à mão, nunca trocada.
  propostaArquivoId    String?
  propostaArquivo      ArquivoCliente?       @relation("PropostaDaLinha", fields: [propostaArquivoId], references: [id], onDelete: SetNull)
  propostaDoSharepoint Boolean               @default(false)
  termoArquivoId       String?
  termoArquivo         ArquivoCliente?       @relation("TermoDaLinha", fields: [termoArquivoId], references: [id], onDelete: SetNull)
  termoDoSharepoint    Boolean               @default(false)
  arquivosSharepoint   ArquivoSharepoint[]
  createdAt      DateTime              @default(now())

  @@index([contratoId])
  @@index([propostaArquivoId])
  @@index([termoArquivoId])
}

// Item de contrato (T_ItensContrato) — base pretendida do cálculo de saldo (§3.6 do design doc).
// `valorTotal` é citado nominalmente no design doc; `descricao`/`quantidade`/`valorUnitario` são
// cadastro razoável — ver ressalva no relatório da Task 1.
//
// `contratoId` é OPCIONAL (mudança feita na Task 2, não na Task 1 original) — achado da Task 2:
// não existe, nos dados reais, nenhuma chave de junção confiável entre `T_ItensContrato` e
// `T_ContratoReceita` (nenhuma FK declarada no .accdb; o texto livre da coluna `Contrato` não bate
// com nenhum campo identificador de `T_ContratoReceita`, mesmo escopado por cliente — 0/146 numa
// checagem manual contra a cópia de teste; a coluna `Cliente` de T_ItensContrato cita 37 siglas,
// a maioria fora dos clientes deste GRC-1, sugerindo uma tabela de itens mais ampla da PRODAM).
// `contratoTextoLegado` guarda o valor bruto da coluna `Contrato` do Access pra permitir
// reconciliação manual depois — ver
// docs/superpowers/specs/2026-09-22-relatorios-clientes-design.md §3.6 (revisto) e o relatório da
// Task 2 (.superpowers/sdd/2026-09-22-relatorios-clientes/task-2-report.md).
model ItemContrato {
  id                  String    @id @default(cuid())
  legacyId            Int?      @unique
  contratoId          String?
  contrato            Contrato? @relation(fields: [contratoId], references: [id])
  // Valor bruto da coluna "Contrato" de T_ItensContrato (ex. "031/SEME/2017") quando não foi
  // possível casar com um Contrato do VerAI — só preenchido quando `contratoId` é null.
  contratoTextoLegado String?
  // Sigla do cliente na linha de T_ItensContrato (SMSUB, SVMA, ...). É o que mantém o item
  // "aguardando" um cliente que ainda não existe no VerAI: quando o cliente é criado com essa
  // sigla (Cliente.siglaLegado), a ficha dele mostra os itens pendentes e o contrato criado a
  // partir do texto já nasce ligado a eles (ver src/lib/relatorios-clientes/itens-aguardando.ts).
  clienteSiglaLegado  String?
  descricao           String?
  quantidade          Decimal?  @db.Decimal(14, 2)
  valorUnitario       Decimal?  @db.Decimal(14, 2)
  valorTotal          Decimal   @db.Decimal(14, 2)
  createdAt           DateTime  @default(now())

  @@index([contratoId])
  @@index([clienteSiglaLegado])
}

// Faturamento mensal (T_Faturamentos). `clienteId` é direto (denormalizado),
// além de `contratoId`, pra sustentar `Cliente.faturamentos` sem precisar
// atravessar Contrato em toda consulta da ficha do cliente (§3.7 do design doc).
model Faturamento {
  id             String       @id @default(cuid())
  legacyId       Int?         @unique
  contratoId     String
  contrato       Contrato     @relation(fields: [contratoId], references: [id])
  clienteId      String
  cliente        Cliente      @relation(fields: [clienteId], references: [id])
  competenciaAno Int?
  competenciaMes Int?
  valor          Decimal?     @db.Decimal(14, 2)
  situacao       String?
  // Colunas reais de T_Faturamentos (Task 6): SEI, Complementar, OBS, UnidadeDestino,
  // Enviado Cliente, Enviado GFP. O "serviço" do mockup vive na nota fiscal, não aqui.
  sei            String?
  complementar   Boolean?
  observacao     String?
  unidadeDestino String?
  enviadoCliente Boolean?
  enviadoGfp     Boolean?
  // PDF anexado manualmente ao faturamento (ex.: a fatura/nota assinada) — sobe pro
  // Vercel Blob via /api/faturamentos/[id]/pdf, mesmo padrão de storage.ts.
  pdfUrl         String?
  pdfNomeArquivo String?
  createdAt      DateTime     @default(now())
  notasFiscais   NotaFiscal[]

  @@index([contratoId])
  @@index([clienteId])
}

// Nota fiscal (T_NotaFiscal) — liga a Faturamento, não a ItemContrato (o
// legado não tem esse vínculo; ver §3.6 do design doc).
model NotaFiscal {
  id            String      @id @default(cuid())
  legacyId      Int?        @unique
  faturamentoId String
  faturamento   Faturamento @relation(fields: [faturamentoId], references: [id])
  numero        String?
  valor         Decimal?    @db.Decimal(14, 2)
  dataEmissao   DateTime?
  // Colunas reais de T_NotaFiscal (Task 6): Serviço, Qtde, Complementar.
  servico       String?
  quantidade    Decimal?    @db.Decimal(14, 2)
  complementar  Boolean?
  createdAt     DateTime    @default(now())

  @@index([faturamentoId])
}

// Demanda/documento (T_Documento). Campos citados em prosa no design doc §4:
// "assunto, tipo, responsável"; `situacao`/`dataAbertura`/`clienteId` são
// cadastro razoável — ver ressalva no relatório da Task 1.
model Demanda {
  id             String           @id @default(cuid())
  legacyId       Int?             @unique
  clienteId      String
  cliente        Cliente          @relation(fields: [clienteId], references: [id])
  assunto        String?
  tipo           String?
  responsavel    String?
  situacao       String?
  dataAbertura   DateTime?
  // Colunas reais de T_Documento (Task 7): TipoAssunto, Documento, SEI.
  tipoAssunto    String?
  documento      String?
  sei            String?
  // Preenchido pelo import quando o cliente foi ATRIBUÍDO (não veio da origem): 109 das 136
  // demandas do GRC-1 não têm cliente válido e, por decisão do usuário (22/09/2026), entram na
  // SMS. Ex.: "cliente vazio no GRC-1". Permite achar e corrigir essas depois.
  notaImportacao String?
  createdAt      DateTime         @default(now())
  tramites       TramiteDemanda[]

  @@index([clienteId])
}

// Trâmite de uma demanda (T_Trâmite) — histórico de posição/ação, citado em
// prosa no design doc §4. `data`/`observacao` são cadastro razoável.
model TramiteDemanda {
  id               String    @id @default(cuid())
  legacyId         Int?      @unique
  demandaId        String
  demanda          Demanda   @relation(fields: [demandaId], references: [id])
  data             DateTime?
  posicao          String?
  acao             String?
  observacao       String?
  // Colunas reais de T_Trâmite (Task 7): Responsável Atual, DataRetorno, ComApresentação, Assinado.
  responsavelAtual String?
  dataRetorno      DateTime?
  comApresentacao  Boolean?
  assinado         Boolean?
  createdAt        DateTime  @default(now())

  @@index([demandaId])
}

// Solicitação de TI — RDM/Solicitação (T_Solicitação). Design doc só cita
// "chamados de TI (RDM/Solicitação)"; campos são cadastro razoável — ver
// ressalva no relatório da Task 1. `legacyId` vem do "Nº" da solicitação
// (§3.2 do design doc).
model Solicitacao {
  id           String    @id @default(cuid())
  legacyId     Int?      @unique
  clienteId    String
  cliente      Cliente   @relation(fields: [clienteId], references: [id])
  tipo         String?
  descricao    String?
  situacao     String?
  dataAbertura DateTime?
  // Colunas reais de T_Solicitação (Task 7): Nº (do chamado — não é único, por isso não é o
  // legacyId), DataFinal, Com visita, Observação.
  numero       String?
  dataFinal    DateTime?
  comVisita    Boolean?
  observacao   String?
  createdAt    DateTime  @default(now())

  @@index([clienteId])
}

model AnaliseEvolucao {
  id                     String    @id @default(cuid())
  clienteId              String
  cliente                Cliente   @relation(fields: [clienteId], references: [id])
  competenciaAtualAno    Int
  competenciaAtualMes    Int
  competenciaAnteriorAno Int
  competenciaAnteriorMes Int
  metricasComparadas     Json
  resumo                 String    @db.Text
  pontosAtencao          Json
  melhorias              Json
  promptVersion          String
  caminhoRelatorioPdf    String?
  relatorioGeradoEm      DateTime?
  createdAt              DateTime  @default(now())

  @@unique([clienteId, competenciaAtualAno, competenciaAtualMes])
}

model AnaliseConsolidada {
  id                  String      @id @default(cuid())
  clienteId           String
  cliente             Cliente     @relation(fields: [clienteId], references: [id])
  competenciaAno      Int
  competenciaMes      Int
  documentos          Documento[] @relation("DocumentosDaConsolidada")
  selecaoAssinatura   String
  resumo              String      @db.Text
  pontosCriticos      Json
  pontosPositivos     Json
  metricasComparadas  Json
  recomendacoes       Json?
  promptVersion       String
  caminhoRelatorioPdf String?
  relatorioGeradoEm   DateTime?
  createdAt           DateTime    @default(now())

  @@unique([clienteId, competenciaAno, competenciaMes, selecaoAssinatura])
}

model Documento {
  id                   String               @id @default(cuid())
  nomeArquivo          String
  tipo                 String // xlsx, csv, pdf, docx
  caminhoOriginal      String
  tamanhoBytes         Int
  status               String               @default("processando") // processando | concluido | erro
  mensagemErro         String?
  uploadedById         String
  uploadedBy           Usuario              @relation(fields: [uploadedById], references: [id])
  clienteId            String
  cliente              Cliente              @relation(fields: [clienteId], references: [id])
  competenciaAno       Int
  competenciaMes       Int
  // Registro no repositório do cliente (mesmo blob de `caminhoOriginal`) — preenchido pelo
  // script scripts/migrar-documentos-para-repositorio.ts. O fluxo antigo continua lendo
  // `caminhoOriginal`.
  arquivoId            String?
  arquivo              ArquivoCliente?      @relation(fields: [arquivoId], references: [id])
  createdAt            DateTime             @default(now())
  analise              Analise?
  acessos              AcessoDocumento[]
  notificacoes         Notificacao[]
  analisesConsolidadas AnaliseConsolidada[] @relation("DocumentosDaConsolidada")

  @@index([clienteId, competenciaAno, competenciaMes])
}

model Analise {
  id                  String    @id @default(cuid())
  documentoId         String    @unique
  documento           Documento @relation(fields: [documentoId], references: [id])
  resumo              String    @db.Text
  pontosCriticos      Json
  pontosPositivos     Json
  metricasChave       Json?
  recomendacoes       Json?
  promptVersion       String
  caminhoRelatorioPdf String?
  relatorioGeradoEm   DateTime?
  createdAt           DateTime  @default(now())
}

model PropostaComercial {
  id                  String                     @id @default(cuid())
  // Nome de exibição da proposta — herda o nome do primeiro arquivo enviado
  // no momento da criação (múltiplos arquivos vivem em `arquivos` abaixo).
  nomeArquivo         String
  tamanhoBytes        Int // soma dos arquivos em `arquivos`
  conteudoMarkdown    String?                    @db.Text // resumo consolidado final — null até concluir, ou quando status é "erro"
  status              String                     @default("rascunho") // rascunho | concluido | erro
  mensagemErro        String?
  // Resultado da checagem por IA da conversão (score, trechos suspeitos,
  // páginas com imagem + ids dos PDFs checados). Só depende dos PDFs, então
  // é reaproveitado até os arquivos mudarem ou alguém pedir "checar de novo".
  checagemIa          Json?
  checagemIaEm        DateTime?
  // Resultado da conferência determinística (sem IA) dos valores de total/
  // resultado geral do PDF contra o documento — atalho rápido, separado da
  // checagem por IA (ver docs/superpowers/specs/2026-09-16-conferencia-totais-design.md).
  conferenciaTotais   Json?
  conferenciaTotaisEm DateTime?
  createdAt           DateTime                   @default(now())
  arquivos            PropostaComercialArquivo[]
}

// Cada arquivo de origem enviado numa conversão (PDF, planilha ou Word) — uma
// proposta pode juntar vários; o conteúdo de cada um é extraído individualmente
// e depois consolidado num único `conteudoMarkdown` na PropostaComercial.
model PropostaComercialArquivo {
  id               String            @id @default(cuid())
  propostaId       String
  proposta         PropostaComercial @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  nomeArquivo      String
  tipo             String // pdf | xlsx | csv | docx
  tamanhoBytes     Int
  caminhoOriginal  String
  conteudoExtraido String?           @db.Text // null quando a extração desse arquivo específico falhou
  ordem            Int // ordem de upload — preserva a sequência que o usuário escolheu
  // Preenchido quando a conversão partiu de um arquivo do repositório do cliente (aba Documentos,
  // "Converter em Markdown"): `caminhoOriginal` é o próprio `urlBlob` dele, sem cópia — por isso
  // excluir este arquivo da proposta nunca apaga o blob. Vira uso em `usosDosArquivos`.
  arquivoClienteId String?
  arquivoCliente   ArquivoCliente?   @relation(fields: [arquivoClienteId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())

  @@index([propostaId])
  @@index([arquivoClienteId])
}

model RegraNotificacao {
  id            String @id @default(cuid())
  criterioTipo  String // tipoDocumento | palavraChaveNome
  criterioValor String
  destinatarios Json
}

model Notificacao {
  id           String    @id @default(cuid())
  documentoId  String
  documento    Documento @relation(fields: [documentoId], references: [id])
  destinatario String
  canal        String // email | dashboard
  lida         Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model AcessoDocumento {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id])
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  acao        String // visualizou | baixou_original | baixou_relatorio
  createdAt   DateTime  @default(now())
}

// Histórico do ConfereAI (`/confere`). A geração em si continua sem estado —
// o Confere é um serviço à parte que não persiste nada e devolve os dois
// documentos no corpo da resposta. O que esta tabela guarda é só o registro
// do que passou por ali: o NOME dos arquivos submetidos (não os arquivos) e
// os dois documentos gerados, pra poder rebaixar sem repetir os ~25s de
// processamento.
//
// Sem vínculo com Cliente: o contrato (quando a planilha achou um, ou a pessoa
// escolheu) e a competência lida do levantamento dizem de que foi o relatório
// (docs/superpowers/specs/2026-09-25-confere-contrato-do-cadastro-design.md
// §7.4). Os dois são opcionais — execuções antigas e envios sem contrato ficam
// sem. Excluir o contrato solta a execução (SetNull), que continua com os nomes.
model ConfereExecucao {
  id               String   @id
  // Só o nome com que o arquivo foi submetido — o PDF e a planilha em si não
  // são guardados em lugar nenhum.
  nomeContrato     String
  nomeLevantamento String
  // Lista de nomes, na ordem de aplicação (que é a ordem em que foram
  // selecionados). Vazia quando o envio não teve aditivo.
  nomesAditivos    Json     @default("[]")
  // URLs no Vercel Blob dos dois documentos gerados.
  caminhoDocx      String
  caminhoXlsx      String
  // A resposta do Confere **sem** os dois base64 (que já viraram os arquivos
  // acima): grid de divergências, placar, análise, avisos. É o que permite
  // reabrir o mesmo resultado em `/confere/historico/[id]` com a tela de
  // sempre, em vez de só rebaixar os arquivos. Opcional porque as execuções
  // gravadas antes deste campo não o têm.
  resultado        Json?
  contratoId       String?
  contrato         Contrato? @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  competenciaAno   Int?
  competenciaMes   Int?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([contratoId])
}

// Endereço de abertura de um processo SEI, guardado POR NÚMERO (`digitos`, ver `chaveDoSei` em
// src/lib/relatorios-clientes/sei.ts): quem cadastra o link uma vez vê o mesmo link em todo lugar
// onde o número aparece (contrato, faturamento, demanda, fornecedor, termo). Sem FK de propósito —
// o número SEI é a chave natural e aparece em várias tabelas.
model LinkSei {
  id        String   @id @default(cuid())
  digitos   String   @unique
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Repositório de documentos do cliente — ver
// docs/superpowers/specs/2026-09-23-repositorio-documentos-cliente-design.md.
// `ArquivoCliente` é o ÚNICO lugar onde arquivo de cliente existe: quem usa o
// arquivo (histórico do contrato, faturamento, ConfereAI, proposta, Documento)
// guarda a referência (`...ArquivoId`), nunca uma URL própria nem uma cópia.
// Unicidade de (clienteId, sha256) entre os NÃO removidos é um índice único
// parcial criado à mão na migração 20260924100000 — o Prisma não expressa
// `WHERE "removidoEm" IS NULL`.
// Contrato e competência NÃO ficam no arquivo (spec §7.1): vêm de quem usa (histórico, faturamento,
// ConfereAI, Documento) — ver usosDosArquivos em src/lib/arquivos/servico.ts.
// ---------------------------------------------------------------------------

enum CategoriaArquivo {
  PROPOSTA_COMERCIAL
  PROPOSTA_ADITIVO
  TERMO_CONTRATO
  TERMO_ADITIVO
  MEDICAO
  FATURA_NF
  PLANILHA
  OFICIO_SEI
  PUBLICACAO_DOC
  RELATORIO_GERADO
  OUTRO
}

enum OrigemArquivo {
  upload
  gerado
  migrado
  sharepoint
}

model ArquivoCliente {
  id             String           @id
  clienteId      String
  cliente        Cliente          @relation(fields: [clienteId], references: [id])
  categoria      CategoriaArquivo
  nome           String
  extensao       String
  contentType    String
  tamanhoBytes   Int
  sha256         String
  // Nunca vai pro navegador — a entrega é sempre por /api/arquivos/[id].
  urlBlob        String
  origem         OrigemArquivo
  enviadoPorId   String?
  enviadoPor     Usuario?         @relation("ArquivosEnviados", fields: [enviadoPorId], references: [id])
  createdAt      DateTime         @default(now())
  removidoEm     DateTime?
  documentos     Documento[]
  acessos        AcessoArquivo[]
  sharepoint     ArquivoSharepoint[]
  linhasComoProposta HistoricoContrato[] @relation("PropostaDaLinha")
  linhasComoTermo    HistoricoContrato[] @relation("TermoDaLinha")
  conversoesMarkdown PropostaComercialArquivo[]

  @@index([clienteId, createdAt])
  @@index([clienteId, categoria])
}

// Estado da sincronização da biblioteca "ContratosReceita" do SharePoint (pasta sincronizada pelo
// OneDrive) — uma linha por caminho. Ver
// docs/superpowers/specs/2026-09-24-sincronizacao-sharepoint-contratos-design.md §5. Sem clienteId
// próprio: o cliente é o do ArquivoCliente (excluir/mesclar cliente não precisam saber deste model).
model ArquivoSharepoint {
  id                 String          @id @default(cuid())
  // Relativo à raiz da biblioteca, separado por "/".
  caminho            String          @unique
  // Primeiro segmento "TC ..." do caminho — só informativo (arquivo não guarda contrato, §7).
  pastaContrato      String?
  tamanhoBytes       Int
  modificadoEm       DateTime
  sha256             String
  arquivoId          String?
  arquivo            ArquivoCliente? @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  vistoEm            DateTime
  removidoNaOrigemEm DateTime?
  // Onde o arquivo cai no fluxo de cliente (spec docs/superpowers/specs/2026-09-23-sharepoint-lugar-certo-design.md
  // §3.3). `null` = sem contrato (publicação do DOC, arquivo solto na pasta do cliente). `pastaContrato`
  // fica só até a limpeza (Task 15 do plano).
  contratoId         String?
  contrato           Contrato?          @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  historicoId        String?
  historico          HistoricoContrato? @relation(fields: [historicoId], references: [id], onDelete: SetNull)

  @@index([arquivoId])
  @@index([contratoId])
  @@index([historicoId])
}

// Uma linha por passada COMPLETA da sincronização do SharePoint (biblioteca inteira, com --aplicar,
// conferência sem divergência, nada suspenso nem falhado) — só para as telas mostrarem "Documentos do
// SharePoint atualizados em …" (docs/superpowers/specs/2026-09-28-sharepoint-atualizado-em-design.md).
// Execução que falha não grava: a data nunca promete mais do que foi feito.
model AtualizacaoSharepoint {
  id          String   @id @default(cuid())
  // Quando a listagem da pasta começou: o VerAI está igual ao SharePoint deste momento.
  iniciadaEm  DateTime
  concluidaEm DateTime @default(now())
  // Arquivos no SharePoint conferidos nesta passada.
  arquivos    Int

  @@index([iniciadaEm])
}

// Biblioteca "Documentos" do SharePoint (spec docs/superpowers/specs/2026-09-29-biblioteca-documentos-prodam-design.md):
// um registro por arquivo da pasta sincronizada pelo OneDrive (~/rede.sp/rede.sp - Documentos). Não é
// ArquivoCliente: preço e calendário são de todos; o dono de um relatório de links é o contrato lido de
// dentro dele. Só tabelas novas — o agendador roda contra produção com o cliente gerado nesta pasta.
model ArquivoBiblioteca {
  id                 String    @id @default(cuid())
  biblioteca         String
  // Relativo à raiz da biblioteca, separado por "/".
  caminho            String
  // TABELA_PRECOS | LINKS_MPLS | CALENDARIO | PLANILHA_CONTRATOS | OUTRO (src/lib/biblioteca/areas.ts)
  area               String
  nome               String
  extensao           String
  contentType        String
  tamanhoBytes       Int
  sha256             String
  // `r2:biblioteca-documentos/<sha256>.<ext>` — nunca vai ao navegador (entrega: /api/biblioteca/[id]).
  chave              String
  modificadoEm       DateTime
  vistoEm            DateTime
  removidoNaOrigemEm DateTime?
  leituraStatus      String?
  leituraMensagem    String?
  lidoEm             DateTime?
  createdAt          DateTime  @default(now())

  @@unique([biblioteca, caminho])
  @@index([biblioteca, area])
}

// "Atualizado em …" das telas da biblioteca Documentos: uma linha por passada completa (mesma regra de
// AtualizacaoSharepoint). Tabela à parte para não mexer no model que o agendador já usa em produção.
model AtualizacaoBiblioteca {
  id          String   @id @default(cuid())
  biblioteca  String
  iniciadaEm  DateTime
  concluidaEm DateTime @default(now())
  arquivos    Int

  @@index([biblioteca, iniciadaEm])
}

// Tabela de preços dos serviços da PRODAM, uma linha por versão ("2026 v3.0") — spec
// docs/superpowers/specs/2026-09-29-tabela-de-precos-design.md. Os arquivo*Id apontam para
// ArquivoBiblioteca (sem FK: o arquivo nunca é apagado, só marcado como removido na origem).
model TabelaPrecos {
  id                   String             @id @default(cuid())
  versao               String             @unique
  ano                  Int
  numero               String
  // ano*10000 + maior*100 + menor: a vigente é a de maior ordem.
  ordem                Int
  publicadaEm          DateTime?
  arquivoPlanilhaId    String?
  arquivoPdfId         String?
  arquivoPublicacaoId  String?
  arquivoInformativoId String?
  totalItens           Int
  divergencias         Int
  lidaEm               DateTime
  itens                ItemTabelaPrecos[]
}

model ItemTabelaPrecos {
  id          String       @id @default(cuid())
  tabelaId    String
  tabela      TabelaPrecos @relation(fields: [tabelaId], references: [id], onDelete: Cascade)
  // Ordem da planilha (a mesma do PDF) — a tela mostra nessa ordem.
  posicao     Int
  grupo       String
  // Caminho das seções: "C - SOLUÇÕES DE SERVIÇOS DE COMUNICAÇÃO > C7. SD-WAN > C7.1. …"
  secoes      String
  codigo      String
  descricao   String
  unidade     String
  preco       Decimal?     @db.Decimal(14, 2)
  sobDemanda  Boolean      @default(false)
  // Texto da célula quando não é número nem "SOB DEMANDA".
  precoTexto  String?
  // confere | diverge | fora-do-pdf | alterado-pelo-informativo | sem-pdf
  conferencia String
  precoNoPdf  Decimal?     @db.Decimal(14, 2)

  @@unique([tabelaId, codigo])
}

// Controle do faturamento por contrato (spec docs/superpowers/specs/2026-09-29-controles-de-contratos-design.md):
// um por PDF de "FATURAMENTO SERVIÇOS PRODAM/Controles de Contratos/<MM.AAAA>/". O vigente de um contrato é o
// do mês mais recente. Totais só valem com a prova "soma das linhas = TOTAL" (…Conferido).
model ControleContrato {
  id                String                  @id @default(cuid())
  arquivoId         String                  @unique
  // sha256 do arquivo lido: releitura só quando o conteúdo muda.
  sha256            String
  mesAno            Int
  mesMes            Int
  sigla             String
  contratoTexto     String?
  contratoId        String?
  clienteId         String?
  termoTexto        String?
  vigenciaTexto     String?
  vigenciaInicio    DateTime?
  vigenciaFim       DateTime?
  previstoTotal     Decimal?                @db.Decimal(14, 2)
  faturadoTotal     Decimal?                @db.Decimal(14, 2)
  saldoTotal        Decimal?                @db.Decimal(14, 2)
  previstoConferido Boolean                 @default(false)
  faturadoConferido Boolean                 @default(false)
  avisos            Json
  lidoEm            DateTime
  linhas            ControleContratoLinha[]

  @@index([contratoId, mesAno, mesMes])
  @@index([mesAno, mesMes])
}

model ControleContratoLinha {
  id         String           @id @default(cuid())
  controleId String
  controle   ControleContrato @relation(fields: [controleId], references: [id], onDelete: Cascade)
  // previsto | faturado | saldo
  tipo       String
  posicao    Int
  rotulo     String
  inicio     DateTime?
  fim        DateTime?
  valor      Decimal          @db.Decimal(14, 2)

  @@index([controleId])
}

// Planilha "Contratos Receita" (biblioteca Documentos, área PLANILHA_CONTRATOS) — uma linha por termo, como
// está na aba BaseContratos. Fonte de prova do valor/vigência (spec 2026-09-29-valor-vigencia-contratos §0).
model LinhaPlanilhaContratos {
  id                 String    @id @default(cuid())
  arquivoId          String
  linha              Int
  sigla              String
  contratoTexto      String
  // "SIGLA|nº ano" — a mesma chave da sincronização do SharePoint.
  chave              String?
  termoTexto         String?
  // 0 = contrato inicial; n = nº do termo; null = sem número.
  termoNumero        Int?
  tipoTermo          String?
  valor              Decimal?  @db.Decimal(14, 2)
  inicio             DateTime?
  fim                DateTime?
  statusFormalizacao String?

  @@index([chave])
  @@index([arquivoId])
}

// De onde veio o valor/vigência/assinatura que o VerAI gravou sozinho numa linha do histórico. Tabela à parte
// (e não colunas em HistoricoContrato) porque o agendador roda contra produção com o cliente Prisma da pasta.
model OrigemCampoHistorico {
  id          String   @id @default(cuid())
  historicoId String
  // valor | vigencia | assinatura
  campo       String
  origem      String
  prova       Json
  gravadoEm   DateTime @default(now())

  @@unique([historicoId, campo])
  @@index([historicoId])
}

// Relatórios "Links MPLS - Relatórios para Faturamento" (biblioteca Documentos, área LINKS_MPLS) — spec
// docs/superpowers/specs/2026-09-29-links-mpls-design.md. Um por PDF; competência = pasta do mês. Contagens só
// valem com a prova "códigos lidos = Total Geral = TOTAL =" de cada seção (`conferido`).
model RelatorioLinks {
  id            String     @id @default(cuid())
  arquivoId     String     @unique
  sha256        String
  ano           Int
  mes           Int
  // SOLUCAO | SOCIAL | GERENCIAMENTO | OUTRA
  categoria     String
  sigla         String
  contratoTexto String?
  contratoId    String?
  clienteId     String?
  servico       String?
  ativos        Int?
  cancelados    Int?
  conferido     Boolean    @default(false)
  avisos        Json
  lidoEm        DateTime
  links         LinkMpls[]

  @@index([ano, mes])
  @@index([contratoId, ano, mes])
  @@index([clienteId])
}

model LinkMpls {
  id               String         @id @default(cuid())
  relatorioId      String
  relatorio        RelatorioLinks @relation(fields: [relatorioId], references: [id], onDelete: Cascade)
  posicao          Int
  // ATIVO | CANCELADO
  situacao         String
  codigo           String
  kbps             Int?
  redundancia      String?
  dataAceite       DateTime?
  dataCancelamento DateTime?
  entidade         String?
  tipoLogradouro   String?
  endereco         String?
  numero           String?

  @@index([relatorioId])
  @@index([codigo])
}

// Calendário de faturamento da PRODAM (biblioteca Documentos, área CALENDARIO) — spec
// docs/superpowers/specs/2026-09-29-calendario-faturamento-design.md. Um por ano. Prazos só com a prova da leitura
// (status "ok"); sem ela, só os feriados ("so-feriados") e o PDF.
model CalendarioFaturamento {
  id        String            @id @default(cuid())
  ano       Int               @unique
  arquivoId String
  sha256    String
  // ok | so-feriados
  status    String
  avisos    Json
  lidoEm    DateTime
  datas     DataFaturamento[]
}

model DataFaturamento {
  id           String                @id @default(cuid())
  calendarioId String
  calendario   CalendarioFaturamento @relation(fields: [calendarioId], references: [id], onDelete: Cascade)
  inicio       DateTime
  fim          DateTime
  // EMISSAO_NFSE | ENCERRAMENTO | ENVIO_RELATORIO | RECEBIMENTO_CONTRATOS | RECEBIMENTO_PROCESSOS_SEI |
  // EXPEDIENTE_SUSPENSO | FERIADO | OUTRO
  tipo         String
  descricao    String

  @@index([calendarioId])
  @@index([inicio])
}

model AcessoArquivo {
  id        String         @id @default(cuid())
  arquivoId String
  arquivo   ArquivoCliente @relation(fields: [arquivoId], references: [id])
  usuarioId String
  usuario   Usuario        @relation("AcessosArquivo", fields: [usuarioId], references: [id])
  acao      String // visualizou | baixou
  createdAt DateTime       @default(now())

  @@index([arquivoId])
}

// ---------------------------------------------------------------------------
// Assistente de IA — ver docs/superpowers/specs/2026-09-23-assistente-ia-design.md
// ---------------------------------------------------------------------------

enum OrigemTrecho {
  HISTORICO_PROPOSTA
  HISTORICO_TERMO
  FATURAMENTO_PDF
  PROPOSTA_COMERCIAL_ARQUIVO
  DOCUMENTO
  ARQUIVO_CLIENTE
  REFERENCIA
}

// Texto oficial (lei, decreto, regulamento interno) que o assistente cita com artigo — spec
// docs/superpowers/specs/2026-09-25-assistente-senior-design.md §4.2. Sem cliente: não usa ArquivoCliente.
// Entra por scripts/referencias-assistente.ts; o arquivo fica no R2 (`urlBlob` = `r2:…`).
model DocumentoReferencia {
  id           String    @id @default(cuid())
  titulo       String
  nomeArquivo  String
  urlBlob      String
  sha256       String    @unique
  contentType  String
  tamanhoBytes Int
  createdAt    DateTime  @default(now())
  removidoEm   DateTime?
}

// Ficha de um PDF do histórico (proposta ou termo), lida UMA vez por versão do índice: primeiro por
// regra, depois IA só no que faltou, com verificação literal do trecho (spec
// docs/superpowers/specs/2026-09-25-assistente-senior-design.md §5). `campos` = { nome: { valor, pagina,
// trecho, fonte } }. Sem FK de propósito, como o índice: `origem` + `origemId` apontam a linha do histórico.
model FichaDocumento {
  id            String       @id @default(cuid())
  origem        OrigemTrecho
  origemId      String
  versao        String?
  campos        Json
  status        String // ok | parcial | sem_texto | erro
  mensagem      String?
  modelo        String?
  tokensEntrada Int?
  tokensSaida   Int?
  geradaEm      DateTime     @default(now())

  @@unique([origem, origemId])
}

// Estado da indexação de UM arquivo (um por origem+registro). `versao` é o `uploadedAt` do blob
// (ISO) ou o hash do texto já extraído; muda quando o arquivo é trocado no mesmo caminho.
model IndiceDocumento {
  id           String            @id @default(cuid())
  origem       OrigemTrecho
  origemId     String
  url          String
  versao       String?
  nomeArquivo  String
  clienteId    String?
  contratoId   String?
  status       String // ok | sem_texto | erro
  mensagem     String?
  totalTrechos Int               @default(0)
  indexadoEm   DateTime          @default(now())
  trechos      TrechoDocumento[]

  @@unique([origem, origemId])
  @@index([clienteId])
}

// Trecho pesquisável. `busca` é gravado no INSERT (to_tsvector('portuguese', unaccent(texto)))
// por SQL cru — o Prisma não escreve tsvector. Sem FK para Cliente/Contrato de propósito: é
// desnormalizado só para filtrar por permissão.
model TrechoDocumento {
  id          String                    @id @default(cuid())
  indiceId    String
  indice      IndiceDocumento           @relation(fields: [indiceId], references: [id], onDelete: Cascade)
  origem      OrigemTrecho
  origemId    String
  clienteId   String?
  contratoId  String?
  nomeArquivo String
  pagina      Int?
  ordem       Int
  texto       String                    @db.Text
  busca       Unsupported("tsvector")?
  createdAt   DateTime                  @default(now())

  @@index([indiceId])
  @@index([clienteId])
  @@index([contratoId])
  @@index([busca], type: Gin)
}

model ConversaAssistente {
  id              String               @id @default(cuid())
  usuarioId       String
  usuario         Usuario              @relation(fields: [usuarioId], references: [id])
  titulo          String
  contextoInicial Json?
  createdAt       DateTime             @default(now())
  atualizadaEm    DateTime             @default(now())
  mensagens       MensagemAssistente[]

  @@index([usuarioId, atualizadaEm])
}

model MensagemAssistente {
  id            String             @id @default(cuid())
  conversaId    String
  conversa      ConversaAssistente @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  papel         String // usuario | assistente
  conteudo      String             @db.Text
  // Nomes + entradas das ferramentas usadas (auditoria). NÃO guarda os resultados.
  ferramentas   Json?
  tokensEntrada Int?
  tokensSaida   Int?
  tokensCache   Int?
  createdAt     DateTime           @default(now())

  @@index([conversaId, createdAt])
}

// IPC-Fipe mensal (Banco Central, SGS 193) — spec 2026-09-30-reajuste-ipc-fipe-design §1.2.
// Mês já gravado nunca é sobrescrito pela sincronização: valor diferente vira divergência.
model IndiceIpcFipe {
  mes       DateTime @id @db.Date
  variacao  Decimal  @db.Decimal(9, 4)
  fonte     String
  buscadoEm DateTime
}

// Histórico do reajuste por IPC-Fipe (spec 2026-09-30-reajuste-ipc-fipe-design §3). `meses` guarda os
// meses e variações usados — prova do cálculo mesmo se a tabela do índice mudar depois.
model ReajusteExecucao {
  id                String   @id @default(cuid())
  usuarioId         String
  usuario           Usuario  @relation(fields: [usuarioId], references: [id])
  nomeArquivo       String
  tipoArquivo       String
  chaveOriginal     String
  chaveResultado    String
  mesInicial        DateTime @db.Date
  mesFinal          DateTime @db.Date
  fator             Decimal  @db.Decimal(12, 8)
  acumuladoPct      Decimal  @db.Decimal(9, 2)
  meses             Json
  quantidadeValores Int
  createdAt         DateTime @default(now())

  @@index([createdAt])
}
