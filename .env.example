NODE_ENV=development

# Database
DATABASE_URL="postgresql://verai_user:verai_pass@localhost:5433/verai"
POSTGRES_DB=verai
POSTGRES_USER=verai_user
POSTGRES_PASSWORD=verai_pass

# Auth
JWT_SECRET=

# Modo de desenvolvimento — login por token + "Simular usuário" no header.
# "1" liga; vazio/ausente desliga (mantenha desligado em produção real).
DEV_AUTH_ENABLED=
DEV_AUTH_TOKEN=

# Upload (Vercel Blob) — em produção o Vercel injeta essa var automaticamente
# ao conectar um Blob store ao projeto. Em dev local, gere um token em
# https://vercel.com/dashboard -> Storage -> seu Blob store -> .env.local
BLOB_READ_WRITE_TOKEN=

# Camada de IA
# AI_PROVIDER=anthropic | google | vertex | groq
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Só necessário se AI_PROVIDER=vertex (usa Application Default Credentials do
# gcloud, não usa AI_API_KEY)
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=

# URL pública da aplicação (usada nos links de e-mail de notificação)
APP_URL=http://localhost:3000

# E-mail (Resend) — se vazio, notificações por e-mail são só logadas, não enviadas
RESEND_API_KEY=
EMAIL_FROM=
